# Staging only. Public storefront checkout always remains a rehearsal.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred: Supabase publishable key, never the service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback, used only when the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Explicitly enable authenticated staging. The DB also requires runtime_mode=staging.
BLOOMS_STAGING_ENABLED=false
